    "            oc = channel_number[i]\n",
    "            mp = i < n - 1\n",
    "            ks, pad = (3, 1) if mp else (1, 0)\n",
    "            self.feature_extractor.add_module(f\"conv_{i}\", self._block(ic, oc, mp, ks, pad))\n",
    "        self.classifier = nn.Sequential()\n",
    "        self.classifier.add_module(\"average_pool\", nn.AvgPool3d((5, 6, 5)))\n",
    "        if dropout:\n",
    "            self.classifier.add_module(\"dropout\", nn.Dropout(0.5))\n",
    "        self.classifier.add_module(f\"conv_{n}\", nn.Conv3d(channel_number[-1], output_dim, 1))\n",
    "\n",
    "    @staticmethod\n",
    "    def _block(ic, oc, maxpool, ks, pad):\n",
    "        layers = [nn.Conv3d(ic, oc, kernel_size=ks, padding=pad), nn.BatchNorm3d(oc)]\n",
    "        if maxpool:\n",
    "            layers.append(nn.MaxPool3d(2, stride=2))\n",
    "        layers.append(nn.ReLU())\n",
    "        return nn.Sequential(*layers)\n",
    "\n",
    "    def forward(self, x):\n",
    "        return F.log_softmax(self.classifier(self.feature_extractor(x)), dim=1)\n",
    "\n",
    "\n",
    "class SexSFCN(nn.Module):\n",
    "    \"\"\"Frozen feature extractor + 512-unit head (2-logit softmax; see decision log).\"\"\"\n",
    "    def __init__(self, feature_extractor, n_features=64 * 5 * 6 * 5, hidden=512, n_classes=2):\n",
    "        super().__init__()\n",
    "        self.feature_extractor = feature_extractor\n",
    "        self.head = nn.Sequential(\n",
    "            nn.Flatten(), nn.Linear(n_features, hidden), nn.ReLU(),\n",
    "            nn.Dropout(0.5), nn.Linear(hidden, n_classes),\n",
    "        )\n",
    "    def forward(self, x):\n",
    "        return self.head(self.feature_extractor(x))\n",
