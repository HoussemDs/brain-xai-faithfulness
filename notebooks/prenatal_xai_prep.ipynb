   "outputs": [],
    "    for a, t in zip(arr.shape, target):\n",
    "        if a >= t:\n",
    "            s = (a - t) // 2; sl_in.append(slice(s, s + t)); sl_out.append(slice(0, t))\n",
    "        else:\n",
    "            s = (t - a) // 2; sl_in.append(slice(0, a)); sl_out.append(slice(s, s + a))\n",
    "    out[tuple(sl_out)] = arr[tuple(sl_in)]\n",
    "    return out\n",
    "\n",
    "def normalize(arr):\n",
    "    m = arr[arr > 0].mean() if (arr > 0).any() else 1.0\n",
    "    return (arr / m).astype(np.float32)\n",
    "\n",
    "_TEMPLATE = None\n",
    "def mni_template():\n",
    "    global _TEMPLATE\n",
    "    if _TEMPLATE is None:\n",
    "        import ants\n",
    "        from antspynet.utilities import get_antsxnet_data\n",
    "        _TEMPLATE = ants.image_read(get_antsxnet_data(\"mni152\"))  # 1 mm MNI152\n",
    "    return _TEMPLATE\n",
    "\n",
    "def preprocess_one(path):\n",
    "    import ants\n",
    "    from antspynet.utilities import brain_extraction\n",
    "    img = ants.image_read(path)\n",
    "    img = ants.n4_bias_field_correction(img)\n",
    "    prob = brain_extraction(img, modality=\"t1\")           # FIRST-RUN CHECK: brain mask sane\n",
    "    brain = img * ants.threshold_image(prob, 0.5, 1.0)\n",
    "    reg = ants.registration(mni_template(), brain, type_of_transform=\"Affine\")\n",
    "    vol = reg[\"warpedmovout\"].numpy()\n",
    "    vol = center_crop_or_pad(vol, CFG[\"SFCN_INPUT\"])\n",
    "    return normalize(vol)\n",
    "\n",
    "def run_preprocessing(manifest):\n",
    "    fails = []\n",
    "    for _, row in manifest.iterrows():\n",
    "        out = DIRS[\"preproc\"] / f\"{row['scan_id']}.npy\"\n",
    "        if out.exists():\n",
    "            continue\n",
    "        try:\n",
    "            vol = preprocess_one(row[\"path\"])\n",
    "            np.save(out, vol)\n",
    "            mid = vol[vol.shape[0] // 2]\n",
    "            plt.imsave(DIRS[\"qc\"] / f\"{row['scan_id']}.png\", mid.T, cmap=\"gray\", origin=\"lower\")\n",
    "        except Exception as e:  # noqa: BLE001\n",
    "            fails.append((row[\"scan_id\"], repr(e)))\n",
    "    frac = len(fails) / max(len(manifest), 1)\n",
    "    print(f\"preprocessed {len(manifest) - len(fails)}/{len(manifest)} | failures: {len(fails)}\")\n",
    "    if fails:\n",
    "        print(\"failures:\", fails)\n",
    "    # Stop rule applies to the real study, not the tiny smoke test.\n",
    "    if frac > 0.25 and CFG[\"MODE\"] != \"smoke\":\n",
    "        raise RuntimeError(f\"STOP RULE: {frac:.0%} of scans failed preprocessing. {fails}\")\n",
    "    return fails\n",
    "\n",
    "if CFG.get(\"SMOKE_SYNTHETIC\"):\n",
    "    rng = np.random.default_rng(CFG[\"SEED\"])\n",
    "    for _, row in manifest.iterrows():\n",
    "        out = DIRS[\"preproc\"] / f\"{row['scan_id']}.npy\"\n",
    "        if not out.exists():\n",
    "            # Faint structure so attributions are not perfectly uniform noise.\n",
    "            vol = (rng.random(CFG[\"SFCN_INPUT\"], dtype=np.float32) * 0.3)\n",
    "            vol[40:120, 48:144, 40:120] += 1.0\n",
    "            np.save(out, normalize(vol))\n",
    "    fails = []\n",
    "    print(\"SMOKE/SYNTHETIC: wrote\", len(manifest), \"random volumes of shape\", CFG[\"SFCN_INPUT\"])\n",
    "elif CFG.get(\"SMOKE_LIGHT\"):\n",
    "    # Real scans, light prep: load NIfTI, resize to the SFCN grid, normalize.\n",
    "    # No skull-strip / MNI registration - those are validated in the pilot (heavy path).\n",
    "    import nibabel as nib\n",
    "    from scipy.ndimage import zoom\n",
    "    fails = []\n",
    "    for _, row in manifest.iterrows():\n",
    "        out = DIRS[\"preproc\"] / f\"{row['scan_id']}.npy\"\n",
    "        if out.exists():\n",
    "            continue\n",
    "        try:\n",
    "            vol = np.asarray(nib.load(row[\"path\"]).get_fdata(), dtype=np.float32)\n",
    "            while vol.ndim > 3:\n",
    "                vol = vol[..., 0]\n",
    "            factors = [t / s for t, s in zip(CFG[\"SFCN_INPUT\"], vol.shape)]\n",
    "            vol = zoom(vol, factors, order=1)\n",
    "            vol = center_crop_or_pad(vol, CFG[\"SFCN_INPUT\"])\n",
    "            np.save(out, normalize(vol))\n",
    "            plt.imsave(DIRS[\"qc\"] / f\"{row['scan_id']}.png\",\n",
    "                       vol[vol.shape[0] // 2].T, cmap=\"gray\", origin=\"lower\")\n",
    "        except Exception as e:  # noqa: BLE001\n",
    "            fails.append((row[\"scan_id\"], repr(e)))\n",
    "    print(f\"SMOKE/LIGHT: prepped {len(manifest) - len(fails)}/{len(manifest)} real scans \"\n",
    "          f\"to {CFG['SFCN_INPUT']} (resize+normalize).\")\n",
    "    if fails:\n",
    "        print(\"failures:\", fails)\n",
