    "    while url:\n",
    "        page = _osf_get(url)\n",
    "        out += page[\"data\"]\n",
    "        url = page[\"links\"].get(\"next\")\n",
    "    return out\n",
    "\n",
    "def _folder_href(items, name):\n",
    "    for it in items:\n",
    "        a = it[\"attributes\"]\n",
    "        if a[\"kind\"] == \"folder\" and a[\"name\"] == name:\n",
    "            return it[\"relationships\"][\"files\"][\"links\"][\"related\"][\"href\"]\n",
    "    raise FileNotFoundError(f\"folder '{name}' not found on OSF node\")\n",
    "\n",
    "def osf_walk(href, parents=()):\n",
    "    \"\"\"Yield (parents_tuple, name, download_url) for files beneath a folder href.\"\"\"\n",
    "    url = href\n",
    "    while url:\n",
    "        page = _osf_get(url)\n",
    "        for it in page[\"data\"]:\n",
    "            a = it[\"attributes\"]\n",
    "            if a[\"kind\"] == \"folder\":\n",
    "                sub = it[\"relationships\"][\"files\"][\"links\"][\"related\"][\"href\"]\n",
    "                yield from osf_walk(sub, parents + (a[\"name\"],))\n",
    "            else:\n",
    "                yield parents, a[\"name\"], it[\"links\"][\"download\"]\n",
    "        url = page[\"links\"].get(\"next\")\n",
    "\n",
    "def download_scans():\n",
    "    # FIRST-RUN CHECK: confirm it finds NIfTI scans under T1_Dataset and the xlsx labels.\n",
    "    manifest_csv = DIRS[\"raw\"] / \"manifest.csv\"\n",
    "    if manifest_csv.exists():\n",
    "        return pd.read_csv(manifest_csv, dtype={\"child_id\": str, \"scan_id\": str})\n",
    "\n",
    "    root = _root_listing(CFG[\"OSF_NODE\"])\n",
    "    t1 = _folder_href(root, CFG[\"T1_FOLDER\"])\n",
    "    n_target = {\"smoke\": CFG[\"N_SMOKE\"], \"pilot\": CFG[\"N_PILOT\"]}.get(CFG[\"MODE\"])\n",
    "\n",
    "    rows, seen = [], set()\n",
    "    for parents, name, dl in osf_walk(t1):\n",
    "        if not name.lower().endswith((\".nii\", \".nii.gz\")):\n",
    "            continue\n",
    "        child = parents[0] if parents else name.split(\"_\")[0]   # <PreschoolID>\n",
    "        scan = name.replace(\".nii.gz\", \"\").replace(\".nii\", \"\")  # <ScanID>\n",
    "        if CFG[\"ONE_SCAN_PER_CHILD\"] and child in seen:\n",
    "            continue\n",
    "        seen.add(child)\n",
    "        out = DIRS[\"raw\"] / f\"{scan}.nii.gz\"\n",
    "        if not out.exists():\n",
    "            urllib.request.urlretrieve(dl, out)\n",
    "        rows.append(dict(child_id=child, scan_id=scan, path=str(out)))\n",
    "        if n_target and len(rows) >= n_target:\n",
    "            break\n",
    "    man = pd.DataFrame(rows)\n",
    "\n",
    "    # Demographics: newest *dated* Calgary_Preschool_Dataset_Updated_YYYYMMDD.xlsx\n",
    "    # (plain \"_v1\" has no date and must not win the sort).\n",
    "    import re\n",
    "    cands = [it for it in root\n",
    "             if it[\"attributes\"][\"name\"].startswith(\"Calgary_Preschool_Dataset\")\n",
    "             and it[\"attributes\"][\"name\"].endswith(\".xlsx\")]\n",
    "    def _date(it):\n",
    "        m = re.search(r\"(\\d{8})\", it[\"attributes\"][\"name\"])\n",
    "        return int(m.group(1)) if m else -1\n",
    "    chosen = max(cands, key=_date)\n",
    "    print(\"demographics file:\", chosen[\"attributes\"][\"name\"])\n",
    "    demo_path = DIRS[\"raw\"] / \"demographics.xlsx\"\n",
    "    if not demo_path.exists():\n",
    "        urllib.request.urlretrieve(chosen[\"links\"][\"download\"], demo_path)\n",
    "    demo = pd.read_excel(demo_path, sheet_name=0).rename(columns={\n",
    "        \"PreschoolID\": \"child_id\", \"ScanID\": \"scan_id\",\n",
    "        \"Age (Years)\": \"age\", \"Biological Sex (Female = 0; Male = 1)\": \"sex\"})\n",
    "    demo[\"scan_id\"] = demo[\"scan_id\"].astype(str).str.strip()\n",
    "    man[\"scan_id\"] = man[\"scan_id\"].astype(str).str.strip()\n",
    "    man = man.merge(demo[[\"scan_id\", \"age\", \"sex\"]], on=\"scan_id\", how=\"left\").reset_index(drop=True)\n",
    "    man.to_csv(manifest_csv, index=False)\n",
    "    return man\n",
    "\n",
    "def make_synthetic_manifest():\n",
    "    \"\"\"Smoke test: a manifest of fake scans (no OSF). Volumes are written in the next cell.\"\"\"\n",
    "    rng = np.random.default_rng(CFG[\"SEED\"])\n",
    "    rows = [dict(child_id=f\"c{i:02d}\", scan_id=f\"synth{i:02d}\", path=\"\",\n",
    "                 age=float(rng.integers(24, 96)), sex=[\"M\", \"F\"][i % 2])\n",
    "            for i in range(CFG[\"N_SMOKE\"])]\n",
    "    man = pd.DataFrame(rows)\n",
    "    man.to_csv(DIRS[\"raw\"] / \"manifest.csv\", index=False)\n",
    "    return man\n",
    "\n",
    "def find_kaggle_manifest():\n",
    "    \"\"\"Prefer an attached Kaggle dataset (robust) over in-kernel OSF download.\"\"\"\n",
    "    base = Path(\"/kaggle/input\")\n",
    "    if base.exists():\n",
    "        for m in base.rglob(\"manifest.csv\"):\n",
    "            return m\n",
    "    return None\n",
    "\n",
    "if CFG.get(\"SMOKE_SYNTHETIC\"):\n",
    "    print(\"SMOKE/SYNTHETIC: fabricating\", CFG[\"N_SMOKE\"], \"fake brains (no data, plumbing check only).\")\n",
    "    manifest = make_synthetic_manifest()\n",
    "else:\n",
    "    km = find_kaggle_manifest()\n",
    "    if km is not None:\n",
    "        manifest = pd.read_csv(km, dtype={\"child_id\": str, \"scan_id\": str})\n",
    "        def _resolve(scan_id):\n",
    "            # Kaggle may have decompressed .nii.gz -> .nii; match by stem, any ext.\n",
    "            for ext in (\".nii.gz\", \".nii\"):\n",
    "                p = km.parent / f\"{scan_id}{ext}\"\n",
    "                if p.exists():\n",
    "                    return str(p)\n",
    "            hits = [h for h in km.parent.rglob(f\"{scan_id}*\")\n",
    "                    if h.suffix in (\".nii\", \".gz\")]\n",
    "            return str(hits[0]) if hits else \"\"\n",
    "        manifest[\"path\"] = manifest[\"scan_id\"].apply(_resolve)\n",
    "        print(f\"loaded {len(manifest)} scans from attached Kaggle dataset: {km.parent}\")\n",
    "        print(manifest[[\"scan_id\", \"path\"]].to_string(index=False))\n",
    "    else:\n",
    "        print(\"no Kaggle dataset attached - falling back to OSF download (local dev).\")\n",
    "        manifest = download_scans()\n",
    "\n",
    "# Encode sex to {0,1}; FIRST-RUN CHECK the mapping matches the demographics coding.\n",
    "if manifest[\"sex\"].dtype == object:\n",
    "    manifest[\"sex_label\"] = (\n",
    "        manifest[\"sex\"].astype(str).str.upper().str[0].map({\"M\": 1, \"F\": 0})  # protocol coding: Female=0, Male=1\n",
    "    )\n",
    "else:\n",
    "    manifest[\"sex_label\"] = manifest[\"sex\"].astype(\"Int64\")\n",
    "print(manifest[[\"child_id\", \"scan_id\", \"age\", \"sex\", \"sex_label\"]].head())\n",
    "print(\"scans:\", len(manifest), \"| children:\", manifest[\"child_id\"].nunique())\n"
   ]
  },
